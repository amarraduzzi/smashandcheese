---
import Layout from '../../layouts/Layout.astro';
import MenuSection from '../../components/MenuSection.astro';
import { menu } from '../../content/menu-highlights';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  page="menu"
  title="Menu — Smash'N Cheese | Burgers, Sandwiches, Desserts in Rabat"
  description="See the full Smash'N Cheese menu: smash burgers, cheese steak, salads, house fries, desserts and drinks. Order via WhatsApp."
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold">Our menu</h1>
      <p class="mt-4 text-text-muted">
        Every dish starts with a ball of fresh beef, smashed to order. Tap an item to order it
        directly via WhatsApp.
      </p>
    </div>

    <nav class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Menu categories">
      {menu.map((category) => (
        <a href={`#${category.id}`} class="rounded-full border border-border px-4 py-1.5 text-sm font-medium text-text-muted hover:border-primary hover:text-primary transition-colors">
          {category.label.en}
        </a>
      ))}
    </nav>

    <div class="mt-14 space-y-14">
      {menu.map((category) => (
        <MenuSection locale={locale} category={category} />
      ))}
    </div>
  </section>
</Layout>
