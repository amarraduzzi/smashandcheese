---
import Layout from '../../layouts/Layout.astro';
import { testimonials, googleReviewsUrl } from '../../content/testimonials';
import { t } from '../../lib/i18n';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  page="reviews"
  title="Customer Reviews — Smash'N Cheese | Rabat"
  description="What our customers say about Smash'N Cheese in Agdal, Rabat."
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">Customer reviews</h1>

    {testimonials.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {testimonials.map((rev) => (
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center gap-1 text-accent" aria-hidden="true">
              {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
            </div>
            <p class="mt-3 text-text-muted">{rev.text.en}</p>
            <p class="mt-4 text-sm font-semibold">{rev.author}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-12 rounded-2xl border border-border bg-surface-muted p-10 text-center">
        <p class="text-text-muted">Customer reviews are coming soon to this page. In the meantime, find us on Google.</p>
        <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
          {t(locale, 'cta_see_all_reviews')}
        </a>
      </div>
    )}
  </section>
</Layout>
