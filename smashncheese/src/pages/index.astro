---
import Layout from '../layouts/Layout.astro';
import { identity, contact, delivery, hours } from '../config/site.config';
import { menu } from '../content/menu-highlights';
import { getWhatsAppOrderLink } from '../lib/whatsapp';
import { localePath, t } from '../lib/i18n';

const locale = 'fr' as const;
const highlightIds = ['burgers'];
const highlights = menu.filter((c) => highlightIds.includes(c.id));
---

<Layout
  locale={locale}
  page="home"
  title="Smash'N Cheese — Le vrai burger smashé à la minute | Rabat"
  description="Burgers 100% bœuf smashés à la minute sur plancha brûlante, pains et frites faits maison. À Agdal, Rabat. Commandez sur place, à emporter, via WhatsApp ou Glovo."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary shadow-sm">
        🔥 100% bœuf, smashé à la minute
      </p>
      <h1 class="mt-6 font-display text-4xl sm:text-6xl font-bold tracking-tight text-text-primary">
        {identity.tagline.fr}
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-text-muted">
        Une boule de bœuf frais écrasée sur une plancha brûlante : croûte caramélisée, cœur juteux.
        Pains, frites et desserts faits maison, chaque jour, à Agdal.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={getWhatsAppOrderLink(locale)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-colors"
        >
          {t(locale, 'cta_order_whatsapp')}
        </a>
        <a
          href={localePath(locale, 'menu')}
          class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-base font-semibold text-text-primary shadow-sm hover:bg-surface-muted transition-colors border border-border"
        >
          {t(locale, 'cta_see_menu')}
        </a>
        <a
          href={delivery.glovoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-base font-semibold text-text-primary hover:text-primary transition-colors"
        >
          {t(locale, 'cta_glovo')} →
        </a>
      </div>
    </div>
  </section>

  <!-- Feature strip -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 grid gap-8 sm:grid-cols-3 text-center">
    {[
      ['🥩', '100% bœuf frais', 'Smashé sur plancha brûlante pour une croûte caramélisée et un cœur juteux.'],
      ['🍞', 'Pains faits maison', 'Préparés chaque jour, moelleux et légèrement toastés.'],
      ['🍫', 'Desserts maison', 'Mousse au chocolat et tiramisu préparés sur place.'],
    ].map(([icon, title, text]) => (
      <div>
        <div class="text-4xl">{icon}</div>
        <h3 class="mt-4 font-display text-lg font-bold">{title}</h3>
        <p class="mt-2 text-sm text-text-muted">{text}</p>
      </div>
    ))}
  </section>

  <!-- Menu highlights -->
  <section class="bg-surface-muted py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold">Nos burgers signature</h2>
        <p class="mt-3 text-text-muted">Un aperçu de la carte — la carte complète est sur la page Menu.</p>
      </div>
      <div class="mt-10 space-y-10">
        {highlights.map((category) => (
          <div>
            <ul class="divide-y divide-border">
              {category.items.map((item) => (
                <li class="py-4 flex items-start justify-between gap-4">
                  <div>
                    <p class="font-semibold">{item.name.fr}</p>
                    {item.description && <p class="mt-1 text-sm text-text-muted">{item.description.fr}</p>}
                  </div>
                  <p class="shrink-0 font-display text-lg font-bold">{item.price} DHS</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a
          href={localePath(locale, 'menu')}
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors"
        >
          Voir toute la carte
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-3xl font-bold text-center">Comment commander</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {[
        ['🍽️', 'Sur place'],
        ['🥡', 'À emporter'],
        ['📞', 'Par téléphone'],
        ['💬', 'Via WhatsApp'],
        ['🛵', 'Livraison Glovo'],
      ].map(([icon, label]) => (
        <div class="rounded-2xl border border-border bg-surface p-6 text-center">
          <div class="text-3xl">{icon}</div>
          <p class="mt-3 font-semibold text-sm">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact teaser -->
  <section class="bg-text-primary text-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid gap-10 sm:grid-cols-2 items-center">
      <div>
        <h2 class="font-display text-3xl font-bold">On vous attend à Agdal</h2>
        <p class="mt-4 text-white/70">{contact.address.full}</p>
        <p class="mt-1 text-white/70">{hours.fr[0].days} : {hours.fr[0].hours}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={contact.mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold hover:bg-primary-dark transition-colors">
            {t(locale, 'cta_directions')}
          </a>
          <a href={`tel:${contact.phone}`} class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-sm font-semibold hover:bg-white/20 transition-colors">
            {t(locale, 'cta_call')} — {contact.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10">
        <iframe
          src={contact.mapEmbedSrc}
          width="100%"
          height="280"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte — Smash'N Cheese"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
