---
import Layout from '../layouts/Layout.astro';
import MenuSection from '../components/MenuSection.astro';
import { menu } from '../content/menu-highlights';

const locale = 'fr' as const;
---

<Layout
  locale={locale}
  page="menu"
  title="Menu — Smash'N Cheese | Burgers, sandwichs, desserts à Rabat"
  description="Découvrez la carte complète de Smash'N Cheese : burgers smashés, cheese steak, salades, frites maison, desserts et boissons. Commandez via WhatsApp."
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold">Notre carte</h1>
      <p class="mt-4 text-text-muted">
        Chaque plat commence par une boule de bœuf frais, smashée à la minute. Cliquez sur un article pour
        le commander directement via WhatsApp.
      </p>
    </div>

    <nav class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Catégories du menu">
      {menu.map((category) => (
        <a
          href={`#${category.id}`}
          class="rounded-full border border-border px-4 py-1.5 text-sm font-medium text-text-muted hover:border-primary hover:text-primary transition-colors"
        >
          {category.label.fr}
        </a>
      ))}
    </nav>

    <div class="mt-14 space-y-14">
      {menu.map((category) => (
        <MenuSection locale={locale} category={category} />
      ))}
    </div>
  </section>
</Layout>
