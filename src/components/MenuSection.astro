---
import type { MenuCategory } from '../content/menu-highlights';
import { getWhatsAppOrderLink } from '../lib/whatsapp';
import { t } from '../lib/i18n';
import type { Locale } from '../config/site.config';

export interface Props {
  locale: Locale;
  category: MenuCategory;
}
const { locale, category } = Astro.props;
const currency = locale === 'ar' ? 'درهم' : 'DHS';
---

<div id={category.id} class="scroll-mt-24">
  <h3 class="font-display text-2xl font-bold text-primary">{category.label[locale]}</h3>
  <ul class="mt-4 divide-y divide-border">
    {category.items.map((item) => (
      <li class="py-4 flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-text-primary">{item.name[locale]}</p>
          {item.description && (
            <p class="mt-1 text-sm text-text-muted">{item.description[locale]}</p>
          )}
          <a
            href={getWhatsAppOrderLink(locale, item.name[locale])}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-[#128C7E] hover:underline"
          >
            {t(locale, 'order_via')} →
          </a>
        </div>
        <p class="shrink-0 font-display text-lg font-bold text-text-primary">{item.price} {currency}</p>
      </li>
    ))}
  </ul>
</div>
