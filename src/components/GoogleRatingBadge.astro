---
// Prominent, real, verifiable rating pill — links straight to the client's
// actual Google listing so a visitor can check it themselves. No review
// count is shown (the client didn't provide one and we don't invent it),
// just the star rating, which they confirmed directly.
import { googleReviewsUrl, googleRating } from '../content/testimonials';

export interface Props {
  label: string; // e.g. "sur Google" / "on Google" / "على Google"
  class?: string;
}
const { label, class: className = '' } = Astro.props;
---

<a
  href={googleReviewsUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-text-primary shadow-sm hover:shadow transition-shadow',
    className,
  ]}
>
  <span class="flex items-center text-accent" aria-hidden="true">
    {Array.from({ length: Math.round(googleRating.value) }).map(() => (
      <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
        <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5Z" />
      </svg>
    ))}
  </span>
  <span>{googleRating.value.toFixed(1)}/5 {label}</span>
</a>
