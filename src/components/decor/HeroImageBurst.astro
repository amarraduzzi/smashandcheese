---
// Companion to HeroDecor.astro, but positioned inside the hero photo's own
// `relative` wrapper (not the section) — it needs to hug the image's actual
// edges, which sit inset from the section by the max-w-6xl container and
// its padding, not by the section's own corners.
---

<svg
  class="deco-shape deco-spin-slow w-[55%] h-[55%] -z-10 -top-[10%] -end-[10%] text-accent opacity-25"
  viewBox="0 0 200 200"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M100 0c5 12 12 17 24 12-3 13 1 20 12 24-12 5-17 12-12 24-13-3-20 1-24 12-5-12-12-17-24-12 3-13-1-20-12-24 12-5 17-12 12-24 13 3 20-1 24-12Z" transform="scale(2.7) translate(-63,-63)" />
</svg>

<!-- little sparkle tucked at the top-right corner of the photo -->
<svg
  class="deco-shape deco-float w-7 h-7 sm:w-9 sm:h-9 -top-3 -end-3 text-primary"
  style="--deco-rot: 10deg; animation-delay: 1.2s;"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M12 0c.6 4.8 1.6 7.8 3 9.5S18.7 11.4 24 12c-4.8.6-7.8 1.6-9.5 3S12.6 18.7 12 24c-.6-4.8-1.6-7.8-3-9.5S5.3 12.6 0 12c4.8-.6 7.8-1.6 9.5-3S11.4 5.3 12 0Z" />
</svg>
