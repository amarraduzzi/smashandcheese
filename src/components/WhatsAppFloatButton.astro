---
// Despite the filename (kept so Layout.astro's import doesn't need
// touching), this is no longer WhatsApp-branded. Ordering always goes
// through the menu/cart — WhatsApp only shows up as the last step, when
// the cart itself sends the finished order — so no floating shortcut on
// the site should look like a direct line to WhatsApp. This is now a
// plain "order now" shortcut in the brand's own colors, pointing at /menu.
import { localePath, t, type PageKey } from '../lib/i18n';
import type { Locale } from '../config/site.config';

export interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const href = localePath(locale, 'menu');
---

{
  // On /menu itself the interactive cart's own FloatingCartBar already
  // serves this role (and does more — shows the running total, opens the
  // real checkout drawer). A second floating button there would just
  // duplicate it, so this one skips rendering on that page.
  page !== 'menu' && (
    <a
      href={href}
      class="wa-float flex items-center gap-2 rounded-full bg-primary px-4 py-3 text-white shadow-lg transition-transform hover:scale-105"
      aria-label={t(locale, 'cta_order_now')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
        <circle cx="9" cy="21" r="1" />
        <circle cx="19" cy="21" r="1" />
        <path d="M2.5 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6" />
      </svg>
      <span class="hidden sm:inline text-sm font-semibold">{t(locale, 'cta_order_now')}</span>
    </a>
  )
}
