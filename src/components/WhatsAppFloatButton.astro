---
import { getWhatsAppOrderLink } from '../lib/whatsapp';
import { t, type PageKey } from '../lib/i18n';
import type { Locale } from '../config/site.config';

export interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const href = getWhatsAppOrderLink(locale);
---

{
  // On /menu itself the interactive cart's own FloatingCartBar already
  // serves this role (and does more — shows the running total, opens the
  // real checkout drawer). A second floating WhatsApp button there would
  // just duplicate it, so this one skips rendering on that page.
  page !== 'menu' && (
    <a
      href={href}
      class="wa-float flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-white shadow-lg transition-transform hover:scale-105"
      aria-label={t(locale, 'cta_order_whatsapp')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.148.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
        <path d="M12.001 2C6.478 2 2 6.477 2 12c0 1.86.505 3.606 1.383 5.104L2 22l5.05-1.352A9.945 9.945 0 0 0 12 22c5.523 0 10-4.477 10-10S17.524 2 12.001 2zm0 18.222a8.19 8.19 0 0 1-4.185-1.145l-.3-.178-3.117.834.834-3.038-.196-.312A8.19 8.19 0 0 1 3.778 12c0-4.542 3.68-8.222 8.223-8.222 4.542 0 8.222 3.68 8.222 8.222 0 4.542-3.68 8.222-8.222 8.222z" />
      </svg>
      <span class="hidden sm:inline text-sm font-semibold">{t(locale, 'cta_order_whatsapp')}</span>
    </a>
  )
}
