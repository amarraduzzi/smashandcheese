---
import { identity, contact } from '../config/site.config';
import { localePath, t, pageSlugs, type PageKey } from '../lib/i18n';
import { locales } from '../config/site.config';
import type { Locale } from '../config/site.config';

export interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;

const navItems: { key: PageKey; labelKey: string }[] = [
  { key: 'home', labelKey: 'nav_home' },
  { key: 'menu', labelKey: 'nav_menu' },
  { key: 'about', labelKey: 'nav_about' },
  { key: 'reviews', labelKey: 'nav_reviews' },
  { key: 'faq', labelKey: 'nav_faq' },
  { key: 'contact', labelKey: 'nav_contact' },
];
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur border-b border-border">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href={localePath(locale, 'home')} class="flex items-center gap-2 font-display text-xl font-bold text-primary shrink-0">
        {identity.name}
      </a>

      <!-- Desktop nav only shows from lg: at md (768-1023px) there isn't
           enough header width for the logo + 6 nav links + language pills +
           full "Commander maintenant" button all in one row without
           overflowing — it was overflowing invisibly (clipped by the
           overflow-x:hidden safety net on body, same failure mode as the
           earlier mobile bug) rather than wrapping or scrolling. So the
           hamburger now covers md too; below lg it's logo + lang + CTA +
           hamburger, which does fit. -->
      <nav class="hidden lg:flex items-center gap-4 xl:gap-6" aria-label="Main navigation">
        {navItems.map((item) => {
          const href = localePath(locale, item.key);
          const isActive = item.key === page;
          return (
            <a
              href={href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-primary',
                isActive ? 'text-primary' : 'text-text-primary',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {t(locale, item.labelKey)}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 lg:gap-2 xl:gap-3 shrink-0">
        <div class="hidden sm:flex items-center gap-1 text-xs">
          {locales.map((l) => (
            <a
              href={localePath(l, page)}
              class:list={[
                'px-2 py-1 rounded uppercase tracking-wide',
                l === locale ? 'bg-primary text-white' : 'text-text-muted hover:bg-surface-muted',
              ]}
              aria-current={l === locale ? 'true' : undefined}
            >
              {l}
            </a>
          ))}
        </div>

        <!-- Mobile-only language dropdown: its own control, separate from
             the hamburger menu (language switching should be a one-tap
             action from anywhere, not two taps buried in the nav panel).
             Same native <details>/group-open pattern as the hamburger. -->
        <details class="relative sm:hidden group">
          <summary
            class="list-none [&::-webkit-details-marker]:hidden marker:hidden cursor-pointer inline-flex items-center gap-1 rounded-full border border-border px-2.5 py-1.5 text-xs font-bold uppercase tracking-wide text-text-primary hover:bg-surface-muted transition-colors"
            aria-label={t(locale, 'lang_name')}
          >
            {locale}
            <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="M5.5 7.5l4.5 4 4.5-4" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <nav
            class="absolute end-0 top-full mt-2 w-28 rounded-xl border border-border bg-surface shadow-lg p-1.5 flex flex-col gap-0.5 z-50"
            aria-label="Language"
          >
            {locales.map((l) => (
              <a
                href={localePath(l, page)}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-semibold uppercase tracking-wide',
                  l === locale ? 'bg-primary text-white' : 'text-text-primary hover:bg-surface-muted',
                ]}
                aria-current={l === locale ? 'true' : undefined}
              >
                {l}
              </a>
            ))}
          </nav>
        </details>

        <a
          href={`tel:${contact.phone}`}
          class="hidden lg:inline-flex items-center text-sm font-semibold text-text-primary hover:text-primary"
        >
          {contact.phoneDisplay}
        </a>

        <!-- Ordering always goes through the menu/cart, never a direct
             wa.me shortcut — WhatsApp only enters the picture as the very
             last step, when the cart itself sends the order. So this CTA
             (and every other one on the site) points at /menu and carries
             no WhatsApp branding.
             Icon-only below sm: logo + language chip + full-text button +
             hamburger doesn't fit a 360-390px header row (measured — it
             pushed the hamburger off-screen). A round cart icon here is
             the same width as the hamburger/language controls next to it. -->
        <a
          href={localePath(locale, 'menu')}
          aria-label={t(locale, 'cta_order_now')}
          class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white shadow-sm transition-colors hover:bg-primary-dark shrink-0"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
            <circle cx="9" cy="21" r="1" />
            <circle cx="19" cy="21" r="1" />
            <path d="M2.5 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6" />
          </svg>
        </a>
        <a
          href={localePath(locale, 'menu')}
          class="hidden sm:inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-dark whitespace-nowrap"
        >
          {t(locale, 'cta_order_now')}
        </a>

        <!-- Mobile nav: a native <details> disclosure instead of the old
             horizontal-scroll link row — that row hid most of the nav
             behind a swipe with no visual hint. `group-open:` lets the
             hamburger/close icon swap regardless of DOM nesting, and the
             browser handles open/close natively (works with JS disabled,
             keyboard-accessible out of the box). The panel itself is
             positioned against the header's own relative wrapper (not
             against <details>, which only sizes to its summary button),
             so it spans the full header width correctly. -->
        <details class="lg:hidden group">
          <summary
            class="list-none [&::-webkit-details-marker]:hidden marker:hidden cursor-pointer inline-flex items-center justify-center w-10 h-10 rounded-full text-text-primary hover:bg-surface-muted transition-colors"
            aria-label={t(locale, 'nav_menu_toggle')}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6 group-open:hidden" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6 hidden group-open:block" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </summary>

          <nav
            class="absolute inset-x-4 top-full mt-2 rounded-2xl border border-border bg-surface shadow-lg p-4 flex flex-col gap-1 z-50"
            aria-label="Main navigation mobile"
          >
            {navItems.map((item) => {
              const href = localePath(locale, item.key);
              const isActive = item.key === page;
              return (
                <a
                  href={href}
                  class:list={[
                    'rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors hover:bg-surface-muted',
                    isActive ? 'text-primary' : 'text-text-primary',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {t(locale, item.labelKey)}
                </a>
              );
            })}
            <div class="mt-2 border-t border-border pt-3">
              <a href={`tel:${contact.phone}`} class="text-sm font-semibold text-text-primary hover:text-primary">
                {contact.phoneDisplay}
              </a>
            </div>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
