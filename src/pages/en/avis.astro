---
import Layout from '../../layouts/Layout.astro';
import { testimonialsByLocale, googleReviewsUrl, googleRating } from '../../content/testimonials';
import { t } from '../../lib/i18n';
import HeroDecor from '../../components/decor/HeroDecor.astro';

const locale = 'en' as const;
const testimonials = testimonialsByLocale[locale];

const reviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: "Smash'N Cheese",
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: googleRating.value,
    bestRating: googleRating.bestRating,
    reviewCount: googleRating.reviewCount,
  },
  ...(testimonials.length > 0
    ? {
        review: testimonials.map((rev) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: rev.author },
          reviewRating: { '@type': 'Rating', ratingValue: rev.rating, bestRating: 5 },
          reviewBody: rev.text,
        })),
      }
    : {}),
};
---

<Layout
  locale={locale}
  page="reviews"
  title="Customer Reviews — Smash'N Cheese | Rabat"
  description="What our customers say about Smash'N Cheese in Agdal, Rabat."
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewJsonLd)} />

  <section class="relative overflow-hidden mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <HeroDecor />
    <img
      src="/images/mascots/badge-fait-maison.png"
      alt=""
      class="deco-bounce-float absolute -top-2 end-2 sm:end-10 w-20 sm:w-28 drop-shadow-lg select-none z-10"
      style="--deco-rot: 8deg;"
      loading="eager"
    />
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">Customer reviews</h1>

    <div class="deco-bounce-in mt-8 mx-auto max-w-md rounded-3xl border border-border bg-surface p-8 text-center shadow-sm">
      <p class="font-display text-5xl font-bold text-primary">{googleRating.value.toFixed(1)}<span class="text-2xl text-text-muted">/{googleRating.bestRating}</span></p>
      <div class="mt-3 flex items-center justify-center gap-1 text-accent" aria-hidden="true">
        {Array.from({ length: Math.round(googleRating.value) }).map(() => (
          <svg viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
            <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5Z" />
          </svg>
        ))}
      </div>
      <p class="mt-3 text-text-muted">Average rating on Google · {googleRating.reviewCount} reviews</p>
      <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
        {t(locale, 'cta_see_all_reviews')}
      </a>
    </div>

    {testimonials.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {testimonials.map((rev) => (
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center gap-1 text-accent" aria-hidden="true">
              {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
            </div>
            <p class="mt-3 text-text-muted">"{rev.text}{rev.truncated ? ' …' : ''}"</p>
            <div class="mt-4 flex items-center justify-between gap-2">
              <p class="text-sm font-semibold">{rev.author}</p>
              {rev.date && <p class="text-xs text-text-muted">{rev.date}</p>}
            </div>
            <p class="mt-1 text-xs text-text-muted">
              via {rev.source ?? 'Google'}
              {rev.translatedFrom && (
                <> · machine-translated by Google from {rev.translatedFrom === 'en' ? 'English' : 'French'}</>
              )}
            </p>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-center text-text-muted">
        Individual reviews are coming soon to this page — in the meantime, all our verified reviews are on Google above.
      </p>
    )}
  </section>
</Layout>
