---
import Layout from '../../layouts/Layout.astro';
import { identity, contact, delivery, hours } from '../../config/site.config';
import { menu } from '../../content/menu-highlights';
import { localePath, t } from '../../lib/i18n';
import HeroDecor from '../../components/decor/HeroDecor.astro';
import HeroImageBurst from '../../components/decor/HeroImageBurst.astro';
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import { testimonials, googleRating, googleReviewsUrl } from '../../content/testimonials';

const locale = 'en' as const;
const highlights = menu.filter((c) => c.id === 'burgers');
---

<Layout
  locale={locale}
  page="home"
  title="Smash'N Cheese — Real Smashed Burgers, Made to Order | Rabat"
  description="100% beef smash burgers cooked to order on a scorching griddle, house-made buns and fries. In Agdal, Rabat. Order dine-in, takeout, via WhatsApp or Glovo."
>
  <section class="relative overflow-hidden bg-surface-muted">
    <HeroDecor />
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24 grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <div class="deco-bounce-in flex flex-wrap items-center gap-3">
          <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary shadow-sm">
            🔥 100% beef, smashed to order
          </p>
          <GoogleRatingBadge label="on Google" />
        </div>
        <h1 class="mt-6 font-display text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
          {identity.tagline.en}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-text-muted">
          A ball of fresh beef smashed onto a scorching-hot griddle: caramelized crust, juicy center.
          House-made buns, fries and desserts, every day, in Agdal.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={localePath(locale, 'menu')} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-colors">
            {t(locale, 'cta_see_menu')}
          </a>
          <a href={delivery.glovoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-base font-semibold text-text-primary hover:text-primary transition-colors">
            {t(locale, 'cta_glovo')} →
          </a>
        </div>
      </div>
      <div class="relative isolate">
        <HeroImageBurst />
        <img
          src="/images/hero-burger-panel.jpg"
          alt="Smash'N Cheese smash burger, melted cheese and caramelized crust"
          width="1000"
          height="750"
          class="w-full rounded-3xl object-cover shadow-lg aspect-[4/3]"
          loading="eager"
          fetchpriority="high"
        />
        <img
          src="/images/mascots/hero-exploding-burger.png"
          alt=""
          class="deco-bounce-float absolute -top-10 -end-8 sm:-top-14 sm:-end-12 w-28 sm:w-36 lg:w-44 drop-shadow-xl select-none z-10"
          style="--deco-rot: 8deg;"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 grid gap-8 sm:grid-cols-3 text-center">
    {[
      ['🥩', 'Fresh 100% beef', 'Smashed on a scorching griddle for a caramelized crust and juicy center.'],
      ['🍞', 'House-made buns', 'Baked fresh every day, soft and lightly toasted.'],
      ['🍫', 'House-made desserts', 'Chocolate mousse and tiramisu prepared in-house.'],
    ].map(([icon, title, text]) => (
      <div>
        <div class="text-4xl">{icon}</div>
        <h3 class="mt-4 font-display text-lg font-bold">{title}</h3>
        <p class="mt-2 text-sm text-text-muted">{text}</p>
      </div>
    ))}
  </section>

  <section class="bg-surface-muted py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold">Our signature burgers</h2>
        <p class="mt-3 text-text-muted">A taste of the menu — see the full menu page for everything.</p>
      </div>
      <div class="mt-10 space-y-10">
        {highlights.map((category) => (
          <ul class="divide-y divide-border">
            {category.items.map((item) => (
              <li class="py-4 flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold">{item.name.en}</p>
                  {item.description && <p class="mt-1 text-sm text-text-muted">{item.description.en}</p>}
                </div>
                <p class="shrink-0 font-display text-lg font-bold">{item.price} DHS</p>
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={localePath(locale, 'menu')} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
          See the full menu
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-3xl font-bold text-center">How to order</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {[
        ['🍽️', 'Dine-in'],
        ['🥡', 'Takeout'],
        ['📞', 'By phone'],
        ['💬', 'Via WhatsApp'],
        ['🛵', 'Glovo delivery'],
      ].map(([icon, label]) => (
        <div class="rounded-2xl border border-border bg-surface p-6 text-center">
          <div class="text-3xl">{icon}</div>
          <p class="mt-3 font-semibold text-sm">{label}</p>
        </div>
      ))}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 text-accent" aria-hidden="true">
          {Array.from({ length: Math.round(googleRating.value) }).map(() => (
            <svg viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
              <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5Z" />
            </svg>
          ))}
        </div>
        <h2 class="mt-3 font-display text-3xl font-bold">{googleRating.value.toFixed(1)}/5 on Google — {googleRating.reviewCount} reviews</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {testimonials.slice(0, 3).map((rev) => (
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center gap-1 text-accent" aria-hidden="true">
              {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
            </div>
            <p class="mt-3 text-text-muted">"{rev.text.en}"</p>
            <p class="mt-4 text-sm font-semibold">{rev.author}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark">
          {t(locale, 'cta_see_all_reviews')} →
        </a>
      </div>
    </section>
  )}

  <section class="bg-text-primary text-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid gap-10 sm:grid-cols-2 items-center">
      <div>
        <h2 class="font-display text-3xl font-bold">Find us in Agdal</h2>
        <p class="mt-4 text-white/70">{contact.address.full}</p>
        <p class="mt-1 text-white/70">{hours.en[0].days}: {hours.en[0].hours}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={contact.mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold hover:bg-primary-dark transition-colors">
            {t(locale, 'cta_directions')}
          </a>
          <a href={`tel:${contact.phone}`} class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-sm font-semibold hover:bg-white/20 transition-colors">
            {t(locale, 'cta_call')} — {contact.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10">
        <iframe src={contact.mapEmbedSrc} width="100%" height="280" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map — Smash'N Cheese"></iframe>
      </div>
    </div>
  </section>
</Layout>
