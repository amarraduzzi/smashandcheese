---
import Layout from '../../layouts/Layout.astro';
import { localePath, t } from '../../lib/i18n';
import HeroDecor from '../../components/decor/HeroDecor.astro';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  page="about"
  title="About — Smash'N Cheese | Rabat"
  description="Smash'N Cheese is all about the smash burger technique: fresh beef smashed on a scorching griddle, house-made buns, fries and desserts every day in Agdal, Rabat."
>
  <section class="relative overflow-hidden mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <HeroDecor />
    <img
      src="/images/mascots/chef-illustration.png"
      alt=""
      class="deco-bounce-float mx-auto w-32 h-32 object-contain"
      style="--deco-rot: -4deg;"
      loading="eager"
    />
    <h1 class="mt-2 font-display text-4xl sm:text-5xl font-bold text-center">About Smash'N Cheese</h1>

    <div class="mt-10 space-y-6 text-lg text-text-muted leading-relaxed">
      <p class="flex flex-col sm:flex-row items-center gap-6">
        <img
          src="/images/mascots/sizzling-patty.png"
          alt=""
          class="deco-float w-28 h-28 object-contain shrink-0"
          style="--deco-rot: 6deg;"
          loading="lazy"
        />
        <span>
          At Smash'N Cheese, everything starts with the same move: a ball of fresh beef, smashed onto
          a scorching-hot griddle. The intense heat instantly caramelizes the surface while the inside
          stays juicy — that's what gives a smash burger its signature taste.
        </span>
      </p>
      <p>
        We don't stop at the beef: our buns, fries and desserts (chocolate mousse, tiramisu) are all
        made in-house, every day, in our Agdal kitchen.
      </p>
      <p>
        Whether it's a quick lunch dine-in, takeout, a phone order, WhatsApp, or Glovo delivery, we
        hold the same standard: a burger smashed to order, ready as fast as possible.
      </p>
    </div>

    <div
      class="mt-12 h-2 w-full"
      style="background-image:url(/images/mascots/checkered-strip.png); background-repeat:repeat-x; background-size:auto 100%;"
      aria-hidden="true"
    ></div>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {[
        ['🔥', 'Smashed to order', 'Every burger is cooked when ordered, never in advance.'],
        ['🏠', '100% house-made', 'Buns, fries and desserts prepared on-site every day.'],
        ['👨‍👩‍👧', 'Family friendly', "A kids' menu and a welcoming space for the whole family."],
      ].map(([icon, title, text]) => (
        <div class="rounded-2xl border border-border p-6 text-center">
          <div class="text-3xl">{icon}</div>
          <h3 class="mt-3 font-display font-bold">{title}</h3>
          <p class="mt-2 text-sm text-text-muted">{text}</p>
        </div>
      ))}
    </div>

    <div class="relative mt-14 text-center">
      <img
        src="/images/mascots/paper-bag.png"
        alt=""
        class="deco-float hidden sm:block absolute -top-6 start-6 w-16 opacity-90 select-none"
        style="--deco-rot: -8deg; animation-delay: 0.4s;"
        loading="lazy"
      />
      <a href={localePath(locale, 'menu')} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
        {t(locale, 'cta_see_menu')}
      </a>
    </div>
  </section>
</Layout>
