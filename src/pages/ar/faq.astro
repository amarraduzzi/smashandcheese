---
import Layout from '../../layouts/Layout.astro';
import { faq } from '../../content/faq';
import HeroDecor from '../../components/decor/HeroDecor.astro';

const locale = 'ar' as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question.ar,
    acceptedAnswer: { '@type': 'Answer', text: item.answer.ar },
  })),
};
---

<Layout
  locale={locale}
  page="faq"
  title="الأسئلة الشائعة — Smash'N Cheese"
  description="التوصيل، ساعات العمل، الطلب عبر واتساب، العنوان: كل الأجوبة عن Smash'N Cheese الرباط."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative overflow-hidden mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <HeroDecor />
    <img
      src="/images/mascots/speech-vrai-burger.png"
      alt=""
      class="deco-bounce-float absolute -top-4 end-0 sm:end-6 w-20 sm:w-28 drop-shadow-lg select-none z-10"
      style="--deco-rot: 8deg;"
      loading="eager"
    />
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">الأسئلة الشائعة</h1>

    <div class="mt-12 divide-y divide-border">
      {faq.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary">
            {item.question.ar}
            <span class="shrink-0 text-primary transition-transform group-open:rotate-45 text-xl">+</span>
          </summary>
          <p class="mt-3 text-text-muted leading-relaxed">{item.answer.ar}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
