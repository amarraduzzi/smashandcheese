---
import Layout from '../../layouts/Layout.astro';
import { localePath, t } from '../../lib/i18n';
import { getWhatsAppOrderLink } from '../../lib/whatsapp';

const locale = 'ar' as const;
---

<Layout
  locale={locale}
  page="about"
  title="من نحن — Smash'N Cheese | الرباط"
  description="Smash'N Cheese هي تقنية سماش برغر: لحم بقري طازج يُسحق على صاج ساخن، خبز وبطاطا وحلويات محضّرة يومياً في أكدال، الرباط."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <img src="/images/mascots/chef-illustration.png" alt="" class="mx-auto w-32 h-32 object-contain" loading="lazy" />
    <h1 class="mt-2 font-display text-4xl sm:text-5xl font-bold text-center">من نحن</h1>

    <div class="mt-10 space-y-6 text-lg text-text-muted leading-relaxed">
      <p class="flex flex-col sm:flex-row items-center gap-6">
        <img src="/images/mascots/sizzling-patty.png" alt="" class="w-28 h-28 object-contain shrink-0" loading="lazy" />
        <span>
          في Smash'N Cheese، كل شيء يبدأ بنفس الحركة: كرة من اللحم البقري الطازج، تُسحق على صاج ساخن جداً.
          الحرارة الشديدة تُكرمل السطح فوراً بينما يبقى الداخل طرياً وعصارياً — هذه هي التقنية التي تمنح
          سماش برغر نكهته المميزة.
        </span>
      </p>
      <p>
        لا نتوقف عند اللحم فقط: خبزنا وبطاطانا وحلوياتنا (موس الشوكولاتة، تيراميسو) محضّرة يدوياً كل يوم
        في مطبخنا بأكدال.
      </p>
      <p>
        سواء كان غداءً سريعاً في المطعم، أو طلباً خارجياً، أو عبر الهاتف أو واتساب، أو توصيلاً عبر Glovo،
        نحافظ على نفس المعيار: برغر يُسحق لحظة الطلب، جاهز بأسرع وقت ممكن.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {[
        ['🔥', 'يُسحق لحظة الطلب', 'كل برغر يُحضّر عند الطلب، أبداً مسبقاً.'],
        ['🏠', '100% محضّر يدوياً', 'خبز وبطاطا وحلويات محضّرة في المطعم كل يوم.'],
        ['👨‍👩‍👧', 'مناسب للعائلات', 'قائمة خاصة بالأطفال واستقبال مخصص لجميع أفراد العائلة.'],
      ].map(([icon, title, text]) => (
        <div class="rounded-2xl border border-border p-6 text-center">
          <div class="text-3xl">{icon}</div>
          <h3 class="mt-3 font-display font-bold">{title}</h3>
          <p class="mt-2 text-sm text-text-muted">{text}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a href={getWhatsAppOrderLink(locale)} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
        {t(locale, 'cta_order_whatsapp')}
      </a>
      <a href={localePath(locale, 'menu')} class="mr-4 inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold hover:border-primary hover:text-primary transition-colors">
        {t(locale, 'cta_see_menu')}
      </a>
    </div>
  </section>
</Layout>
