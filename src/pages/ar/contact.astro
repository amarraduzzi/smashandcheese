---
import Layout from '../../layouts/Layout.astro';
import { contact, hours, delivery } from '../../config/site.config';
import { getWhatsAppOrderLink } from '../../lib/whatsapp';
import { t } from '../../lib/i18n';

const locale = 'ar' as const;
---

<Layout
  locale={locale}
  page="contact"
  title="اتصل بنا — Smash'N Cheese | أكدال، الرباط"
  description="العنوان والهاتف وساعات العمل والاتجاهات إلى Smash'N Cheese في أكدال، الرباط. اطلبوا عبر واتساب أو الهاتف أو Glovo."
>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">اتصل بنا</h1>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div class="space-y-8">
        <div>
          <h2 class="font-display text-xl font-bold">{t(locale, 'address_title')}</h2>
          <p class="mt-2 text-text-muted">{contact.address.full}</p>
          <a href={contact.mapLink} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-primary hover:underline">
            {t(locale, 'cta_directions')} ←
          </a>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold">الهاتف</h2>
          <a href={`tel:${contact.phone}`} class="mt-2 inline-block text-text-muted hover:text-primary">
            {contact.phoneDisplay}
          </a>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold">{t(locale, 'hours_title')}</h2>
          <ul class="mt-2 space-y-1 text-text-muted">
            {hours.ar.map((h) => (
              <li class="flex justify-between gap-4 max-w-xs">
                <span>{h.days}</span>
                <span>{h.hours}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href={getWhatsAppOrderLink(locale)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
            {t(locale, 'cta_order_whatsapp')}
          </a>
          <a href={delivery.glovoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold hover:border-primary hover:text-primary transition-colors">
            {t(locale, 'cta_glovo')}
          </a>
        </div>
      </div>

      <div class="rounded-2xl overflow-hidden border border-border h-80 lg:h-full">
        <iframe src={contact.mapEmbedSrc} width="100%" height="100%" style="border:0; min-height: 320px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="خريطة — Smash'N Cheese"></iframe>
      </div>
    </div>
  </section>
</Layout>
