---
import Layout from '../../layouts/Layout.astro';
import OrderApp from '../../order/OrderApp';
import { categories, menuItems } from '../../order/data/menu';
import { identity } from '../../config/site.config';

const locale = 'ar' as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: identity.name,
  hasMenu: {
    '@type': 'Menu',
    hasMenuSection: categories.map((category) => ({
      '@type': 'MenuSection',
      name: category.label.ar,
      hasMenuItem: menuItems
        .filter((item) => item.categoryId === category.id)
        .map((item) => ({
          '@type': 'MenuItem',
          name: item.name.ar,
          description: item.description?.ar,
          offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
        })),
    })),
  },
};
---

<Layout
  locale={locale}
  page="menu"
  title="القائمة — Smash'N Cheese | برغر وساندويتش وحلويات في الرباط"
  description="اكتشفوا القائمة الكاملة لـ Smash'N Cheese. أضيفوا الأصناف إلى السلة، وستُرسل طلبكم مباشرة عبر واتساب."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-16 pb-6 text-center">
    <h1 class="font-display text-4xl sm:text-5xl font-bold">قائمتنا</h1>
    <p class="mt-4 text-text-muted">
      كل طبق يبدأ بكرة من اللحم البقري الطازج، تُسحق لحظة الطلب. أضيفوا الأصناف إلى السلة أدناه —
      وسيصل طلبكم مباشرة عبر واتساب.
    </p>
  </section>

  <OrderApp language="ar" client:load />
</Layout>
