---
import Layout from '../../layouts/Layout.astro';
import OrderApp from '../../order/OrderApp';
import { categories, menuItems } from '../../order/data/menu';
import { identity } from '../../config/site.config';
import HeroDecor from '../../components/decor/HeroDecor.astro';

const locale = 'ar' as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: identity.name,
  hasMenu: {
    '@type': 'Menu',
    hasMenuSection: categories.map((category) => ({
      '@type': 'MenuSection',
      name: category.label.ar,
      hasMenuItem: menuItems
        .filter((item) => item.categoryId === category.id)
        .map((item) => ({
          '@type': 'MenuItem',
          name: item.name.ar,
          description: item.description?.ar,
          offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
        })),
    })),
  },
};
---

<Layout
  locale={locale}
  page="menu"
  title="القائمة — Smash'N Cheese | برغر وساندويتش وحلويات في الرباط"
  description="اكتشفوا القائمة الكاملة لـ Smash'N Cheese. أضيفوا الأصناف إلى السلة، وستُرسل طلبكم مباشرة عبر واتساب."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative overflow-hidden mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-16 pb-6 text-center">
    <HeroDecor />
    <img
      src="/images/mascots/mascot-burger.png"
      alt=""
      class="deco-bounce-float absolute -top-2 end-2 sm:end-10 w-16 sm:w-24 drop-shadow-lg select-none z-10"
      style="--deco-rot: -10deg;"
      loading="eager"
    />
    <h1 class="font-display text-4xl sm:text-5xl font-bold">قائمتنا</h1>
    <p class="mt-4 text-text-muted">
      كل طبق يبدأ بكرة من اللحم البقري الطازج، تُسحق لحظة الطلب. أضيفوا الأصناف إلى السلة أدناه —
      وسيصل طلبكم مباشرة عبر واتساب.
    </p>
  </section>

  <div
    class="h-2 w-full max-w-4xl mx-auto"
    style="background-image:url(/images/mascots/checkered-strip.png); background-repeat:repeat-x; background-size:auto 100%;"
    aria-hidden="true"
  ></div>

  <OrderApp language="ar" client:load />
</Layout>
