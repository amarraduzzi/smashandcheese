---
import Layout from '../../layouts/Layout.astro';
import { identity, contact, delivery, hours } from '../../config/site.config';
import { menu } from '../../content/menu-highlights';
import { getWhatsAppOrderLink } from '../../lib/whatsapp';
import { localePath, t } from '../../lib/i18n';

const locale = 'ar' as const;
const highlights = menu.filter((c) => c.id === 'burgers');
---

<Layout
  locale={locale}
  page="home"
  title="Smash'N Cheese — سماش برغر حقيقي يُحضّر لحظة الطلب | الرباط"
  description="برغر سماش 100% لحم بقري يُطهى لحظة الطلب على صاج ساخن، خبز وبطاطا محضّرة يدوياً. في أكدال، الرباط. اطلبوا في المطعم، أو خارجياً، عبر واتساب أو Glovo."
>
  <section class="relative overflow-hidden bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary shadow-sm">
        🔥 100% لحم بقري، يُسحق لحظة الطلب
      </p>
      <h1 class="mt-6 font-display text-4xl sm:text-6xl font-bold tracking-tight text-text-primary">
        {identity.tagline.ar}
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-text-muted">
        كرة من اللحم البقري الطازج تُسحق على صاج ساخن جداً: قشرة مكرملة وقلب طري وعصاري.
        خبز وبطاطا وحلويات محضّرة يومياً في أكدال.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={getWhatsAppOrderLink(locale)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-colors">
          {t(locale, 'cta_order_whatsapp')}
        </a>
        <a href={localePath(locale, 'menu')} class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-base font-semibold text-text-primary shadow-sm hover:bg-surface-muted transition-colors border border-border">
          {t(locale, 'cta_see_menu')}
        </a>
        <a href={delivery.glovoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-base font-semibold text-text-primary hover:text-primary transition-colors">
          {t(locale, 'cta_glovo')} ←
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 grid gap-8 sm:grid-cols-3 text-center">
    {[
      ['🥩', 'لحم بقري طازج 100%', 'يُسحق على صاج ساخن جداً لقشرة مكرملة وقلب طري.'],
      ['🍞', 'خبز محضّر يدوياً', 'يُخبز طازجاً كل يوم، طري ومحمّص قليلاً.'],
      ['🍫', 'حلويات محضّرة يدوياً', 'موس الشوكولاتة والتيراميسو محضّران في المطعم.'],
    ].map(([icon, title, text]) => (
      <div>
        <div class="text-4xl">{icon}</div>
        <h3 class="mt-4 font-display text-lg font-bold">{title}</h3>
        <p class="mt-2 text-sm text-text-muted">{text}</p>
      </div>
    ))}
  </section>

  <section class="bg-surface-muted py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold">برغراتنا المميزة</h2>
        <p class="mt-3 text-text-muted">لمحة عن القائمة — القائمة الكاملة في صفحة القائمة.</p>
      </div>
      <div class="mt-10 space-y-10">
        {highlights.map((category) => (
          <ul class="divide-y divide-border">
            {category.items.map((item) => (
              <li class="py-4 flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold">{item.name.ar}</p>
                  {item.description && <p class="mt-1 text-sm text-text-muted">{item.description.ar}</p>}
                </div>
                <p class="shrink-0 font-display text-lg font-bold">{item.price} درهم</p>
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={localePath(locale, 'menu')} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors">
          مشاهدة القائمة الكاملة
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-display text-3xl font-bold text-center">كيف تطلب</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {[
        ['🍽️', 'في المطعم'],
        ['🥡', 'خارجي'],
        ['📞', 'عبر الهاتف'],
        ['💬', 'عبر واتساب'],
        ['🛵', 'توصيل Glovo'],
      ].map(([icon, label]) => (
        <div class="rounded-2xl border border-border bg-surface p-6 text-center">
          <div class="text-3xl">{icon}</div>
          <p class="mt-3 font-semibold text-sm">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-text-primary text-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid gap-10 sm:grid-cols-2 items-center">
      <div>
        <h2 class="font-display text-3xl font-bold">نستقبلكم في أكدال</h2>
        <p class="mt-4 text-white/70">{contact.address.full}</p>
        <p class="mt-1 text-white/70">{hours.ar[0].days}: {hours.ar[0].hours}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={contact.mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold hover:bg-primary-dark transition-colors">
            {t(locale, 'cta_directions')}
          </a>
          <a href={`tel:${contact.phone}`} class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-sm font-semibold hover:bg-white/20 transition-colors">
            {t(locale, 'cta_call')} — {contact.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10">
        <iframe src={contact.mapEmbedSrc} width="100%" height="280" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="خريطة — Smash'N Cheese"></iframe>
      </div>
    </div>
  </section>
</Layout>
