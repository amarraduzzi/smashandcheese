---
import Layout from '../layouts/Layout.astro';
import { faq } from '../content/faq';
import HeroDecor from '../components/decor/HeroDecor.astro';

const locale = 'fr' as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question.fr,
    acceptedAnswer: { '@type': 'Answer', text: item.answer.fr },
  })),
};
---

<Layout
  locale={locale}
  page="faq"
  title="FAQ — Smash'N Cheese | Questions fréquentes"
  description="Livraison, horaires, commande WhatsApp, adresse : toutes les réponses à vos questions sur Smash'N Cheese Rabat."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative overflow-hidden mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <HeroDecor />
    <img
      src="/images/mascots/speech-vrai-burger.png"
      alt=""
      class="deco-bounce-float absolute -top-4 end-0 sm:end-6 w-20 sm:w-28 drop-shadow-lg select-none z-10"
      style="--deco-rot: 8deg;"
      loading="eager"
    />
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">Questions fréquentes</h1>

    <div class="mt-12 divide-y divide-border">
      {faq.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary">
            {item.question.fr}
            <span class="shrink-0 text-primary transition-transform group-open:rotate-45 text-xl">+</span>
          </summary>
          <p class="mt-3 text-text-muted leading-relaxed">{item.answer.fr}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
