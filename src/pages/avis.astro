---
import Layout from '../layouts/Layout.astro';
import { testimonials, googleReviewsUrl, googleRating } from '../content/testimonials';
import { t } from '../lib/i18n';

const locale = 'fr' as const;

// Only emit AggregateRating/Review structured data once real reviews exist —
// no fabricated ratings, ever.
const reviewJsonLd =
  testimonials.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'Restaurant',
        name: "Smash'N Cheese",
        review: testimonials.map((rev) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: rev.author },
          reviewRating: { '@type': 'Rating', ratingValue: rev.rating, bestRating: 5 },
          reviewBody: rev.text.fr,
        })),
      }
    : null;
---

<Layout
  locale={locale}
  page="reviews"
  title="Avis clients — Smash'N Cheese | Rabat"
  description="Ce que nos clients disent de Smash'N Cheese à Agdal, Rabat."
>
  {reviewJsonLd && <script type="application/ld+json" set:html={JSON.stringify(reviewJsonLd)} />}

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-center">Avis clients</h1>

    <div class="mt-8 mx-auto max-w-md rounded-3xl border border-border bg-surface p-8 text-center shadow-sm">
      <p class="font-display text-5xl font-bold text-primary">{googleRating.value.toFixed(1)}<span class="text-2xl text-text-muted">/{googleRating.bestRating}</span></p>
      <div class="mt-3 flex items-center justify-center gap-1 text-accent" aria-hidden="true">
        {Array.from({ length: Math.round(googleRating.value) }).map(() => (
          <svg viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
            <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5Z" />
          </svg>
        ))}
      </div>
      <p class="mt-3 text-text-muted">Note moyenne sur Google</p>
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark transition-colors"
      >
        {t(locale, 'cta_see_all_reviews')}
      </a>
    </div>

    {testimonials.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {testimonials.map((rev) => (
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center gap-1 text-accent" aria-hidden="true">
              {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
            </div>
            <p class="mt-3 text-text-muted">{rev.text.fr}</p>
            <p class="mt-4 text-sm font-semibold">{rev.author}</p>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-center text-text-muted">
        Les avis détaillés arrivent bientôt sur cette page — en attendant, tous nos avis vérifiés sont sur Google ci-dessus.
      </p>
    )}
  </section>
</Layout>
