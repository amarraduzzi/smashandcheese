---
import Layout from '../layouts/Layout.astro';
import OrderApp from '../order/OrderApp';
import { categories, menuItems } from '../order/data/menu';
import { identity } from '../config/site.config';

const locale = 'fr' as const;

// Crawlable menu data for bots that don't execute JS (the interactive cart
// below is a client-side island — see astro.config.mjs's note on why).
// Same schema.org shape the order-engine's own SEO plugin uses.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: identity.name,
  hasMenu: {
    '@type': 'Menu',
    hasMenuSection: categories.map((category) => ({
      '@type': 'MenuSection',
      name: category.label.fr,
      hasMenuItem: menuItems
        .filter((item) => item.categoryId === category.id)
        .map((item) => ({
          '@type': 'MenuItem',
          name: item.name.fr,
          description: item.description?.fr,
          offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
        })),
    })),
  },
};
---

<Layout
  locale={locale}
  page="menu"
  title="Menu — Smash'N Cheese | Burgers, sandwichs, desserts à Rabat"
  description="Découvrez la carte complète de Smash'N Cheese : burgers smashés, cheese steak, salades, frites maison, desserts et boissons. Composez votre commande, envoyez-la directement sur WhatsApp."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-16 pb-6 text-center">
    <h1 class="font-display text-4xl sm:text-5xl font-bold">Notre carte</h1>
    <p class="mt-4 text-text-muted">
      Chaque plat commence par une boule de bœuf frais, smashée à la minute. Ajoutez vos articles au
      panier ci-dessous, votre commande part directement sur WhatsApp.
    </p>
  </section>

  <OrderApp language="fr" client:load />
</Layout>
