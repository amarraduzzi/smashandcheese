---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatButton from '../components/WhatsAppFloatButton.astro';
import { identity, contact, hours } from '../config/site.config';
import { googleRating } from '../content/testimonials';
import { locales } from '../config/site.config';
import { localePath, t, type PageKey } from '../lib/i18n';
import type { Locale } from '../config/site.config';
import '../styles/global.css';

export interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, page, title, description, noindex = false } = Astro.props;
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const canonical = new URL(localePath(locale, page), identity.siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: identity.name,
  image: new URL('/images/hero-burger.jpg', identity.siteUrl).toString(),
  url: identity.siteUrl,
  telephone: contact.phone,
  servesCuisine: 'Burgers',
  priceRange: '$$',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: googleRating.value,
    bestRating: googleRating.bestRating,
    reviewCount: googleRating.reviewCount,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.area,
    addressCountry: 'MA',
  },
  openingHoursSpecification: hours.structured.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dayOfWeek,
    opens: h.opens,
    closes: h.closes,
  })),
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(localePath(l, page), identity.siteUrl).toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('fr', page), identity.siteUrl).toString()}
    />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={identity.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,700&family=Poppins:wght@300;400;600;700&family=Lora:ital,wght@1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-background text-text-primary font-body antialiased">
    <a href="#main" class="skip-link">{t(locale, 'skip_to_content')}</a>
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloatButton locale={locale} page={page} />
  </body>
</html>
